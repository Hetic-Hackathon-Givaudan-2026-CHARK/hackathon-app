# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
DATABASE_URL=postgres://app:app@db:5432/app

# Assistant : Ollama sur la machine hôte (ADR 0013). Avant : ollama pull llama3.2:1b
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=
# Attente maximale du LLM, relance comprise ; au-delà, textes des fiches (ADR 0012)
AI_TIMEOUT_MS=30000
# AI_DEBUG=1 affiche la réponse brute du modèle dans le journal de l'API

# Service RAG de l'équipe Data (ADR 0008) : URL ngrok fournie par l'équipe Data,
# sans /docs ni « / » final, à mettre à jour à chaque redémarrage du tunnel.
DATA_API_URL=
DATA_API_TIMEOUT_MS=8000

# Simulation de démo : délai avant qu'un échantillon commandé passe à « expédié » (0 = jamais)
DEMO_SHIPPING_DELAY_MS=6000
