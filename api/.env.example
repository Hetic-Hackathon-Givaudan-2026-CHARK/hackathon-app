# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
DATABASE_URL=postgres://app:app@db:5432/app

# IA : n'importe quel fournisseur compatible OpenAI (ADR 0006 et 0009).

# Fournisseur retenu : Mistral (ADR 0009). Clé sur https://console.mistral.ai
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_API_KEY=
# Délai maximal d'un appel au LLM ; au-delà, l'API sert les propositions figées (ADR 0012)
AI_TIMEOUT_MS=15000

# Service RAG de l'équipe Data (ADR 0008). URL ngrok, à mettre à jour à chaque redémarrage du tunnel.
DATA_API_URL=
DATA_API_TIMEOUT_MS=8000

# Simulation de démo : délai avant qu'un échantillon commandé passe à « expédié » (0 = jamais)
DEMO_SHIPPING_DELAY_MS=6000

# Repli : Ollama installé sur votre machine
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.2:1b
# AI_API_KEY=

# Repli : Ollama en conteneur (docker compose up -d ollama)
# AI_BASE_URL=http://ollama:11434/v1

