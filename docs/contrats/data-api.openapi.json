{
  "openapi": "3.1.0",
  "info": {
    "title": "Intelligent Ordering Platform RAG API",
    "description": "API RAG de démonstration permettant de rechercher des informations sur des clients, produits, commandes, matières premières et échantillons synthétiques.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Système"],
        "summary": "Health",
        "description": "État de l'API, des modèles et de l'index vectoriel.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/demo/ping": {
      "get": {
        "tags": ["Démonstration"],
        "summary": "Demo Ping",
        "description": "Endpoint dummy, ne retournant aucune donnée métier.",
        "operationId": "demo_ping_demo_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Demo Ping Demo Ping Get"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "tags": ["Recherche"],
        "summary": "Search",
        "description": "Retourne les sources pertinentes sans appeler le LLM.",
        "operationId": "search_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  },
                  "type": "array",
                  "title": "Response Search Search Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": ["RAG"],
        "summary": "Ask",
        "description": "Répond à une question à partir des documents récupérés.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question",
            "examples": [
              "Quel produit NutriPeak Foods a-t-il recommandé en février 2025 ?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Nombre maximal de documents pertinents à rechercher.",
            "default": 4
          }
        },
        "type": "object",
        "required": ["question"],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": ["question", "answer", "model", "sources"],
        "title": "AskResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Source": {
        "properties": {
          "section": {
            "type": "string",
            "title": "Section"
          },
          "document_type": {
            "type": "string",
            "title": "Document Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Score de similarité : plus il est proche de 1, plus la source est pertinente."
          }
        },
        "type": "object",
        "required": ["section", "document_type", "text", "score"],
        "title": "Source"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
